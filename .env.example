# Local development values only. Copy to .env and replace every CHANGE_ME value.
POSTGRES_DB=unimanage
POSTGRES_USER=unimanage
POSTGRES_PASSWORD=CHANGE_ME_local_database_password
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/unimanage
DATABASE_USERNAME=unimanage
DATABASE_PASSWORD=CHANGE_ME_local_database_password

# Use a randomly generated value with at least 32 bytes of entropy.
APP_JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_before_starting
APP_JWT_ISSUER=unimanage-api
APP_JWT_TTL=PT30M
APP_CORS_ORIGIN=http://localhost:5173

# Optional first-run admin account. Change both values before starting the API.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_first_admin_password
APP_BOOTSTRAP_ADMIN_NAME=UniManage Administrator
